# ==========================================
# Arena Homes Backend - Environment Variables
# ==========================================

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=4000

# Database Configuration
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arena_db

# Security & Authentication
# IMPORTANT: Generate strong secrets for production!
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_32_chars_change_in_production
REFRESH_TOKEN_SECRET=your_refresh_token_secret_min_32_chars_change_in_production
